# Optional sandbox image with a real headless browser, used to run browser journeys on static sites with NO network.
# Build:  docker build -f sandbox/Dockerfile.browser -t fixengine-sandbox-browser:1 sandbox
# If this image is not built, journeys are skipped automatically and everything else works as before.
# (Check that the base tag still exists on mcr.microsoft.com/playwright/python; any recent tag works.)
FROM mcr.microsoft.com/playwright/python:v1.48.0-jammy
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin sandbox \
 && mkdir -p /work && chown 10001:10001 /work
COPY journey_runner.py /opt/journey_runner.py
ENV HOME=/tmp
USER 10001
WORKDIR /work
