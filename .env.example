# Copy this file to a new file named exactly  .env   (same folder) and paste your key after the = sign.
# .env is ignored by git and by Docker, so it never leaves your computer. Never paste a key into any other file or into a chat.

# One key for Claude (Haiku / Sonnet / Opus) and the free model, from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# auto = use direct Claude/Groq keys if you have them, otherwise OpenRouter.   openrouter = always OpenRouter.   direct = never OpenRouter.
FIXENGINE_PROVIDER=auto

# Optional: direct keys (leave empty if you only use OpenRouter)
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Money limits for the benchmark, in rupees (about 1 US dollar = 90)
FIXENGINE_CREDITS_INR=400
FIXENGINE_BUDGET_INR=300

# Sandbox for the benchmark / local runs: docker (needs Docker here), remote (a sandbox_service.py host), local_unsafe (tests only)
FIXENGINE_SANDBOX_MODE=docker
FIXENGINE_SANDBOX_URL=
FIXENGINE_SANDBOX_SECRET=
