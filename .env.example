# Agent Daemon settings. Copy this file to a new file named exactly  .env  (same folder) for local runs.
# .env is ignored by git and by Docker, so it never leaves your computer. On Render, set these on the Environment screen.
# Never paste a real key into this file, into any other file, or into a chat. Values below are empty or harmless defaults.

# ---------------------------------------------------------------- core (REQUIRED in production: the app refuses to start without them)
APP_ENV=development
# PostgreSQL in production (Render fills it from the database). Empty locally = SQLite file portal.db
DATABASE_URL=
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Encrypts saved GitHub tokens and monitor keys: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- public address (monitors and GitHub webhooks send data here)
PORTAL_BASE_URL=
# Production domain: lets secure login/OAuth cookies work on both the apex and www host.
COOKIE_DOMAIN=

# ---------------------------------------------------------------- sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=
ADMIN_EMAILS=
SUPPORT_EMAIL=
# Admin password sign-in: set ADMIN_PASSWORD_<NORMALIZED_ADMIN_EMAIL> for each configured administrator.


# ---------------------------------------------------------------- email (warnings, "monitor offline", "make your repo private")
BREVO_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------- AI providers (OpenRouter alone is enough)
OPENROUTER_API_KEY=
# auto = direct Claude/Groq keys if you have them, otherwise OpenRouter.  openrouter = always OpenRouter.  direct = never OpenRouter.
FIXENGINE_PROVIDER=auto
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Optional, only used to double-check model names before a "retired AI model" fix (otherwise OpenRouter's public list is used)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model ids, changeable without a code change (defaults are in fixengine/config.py)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
CHATBOT_MODEL=openai/gpt-oss-120b
FIXENGINE_MODEL_GROQ=
FIXENGINE_MODEL_HAIKU=
FIXENGINE_MODEL_SONNET=
FIXENGINE_MODEL_OPUS=
# Retired-model list + replacements: edit model_registry.json, or paste a whole JSON registry here
MODEL_REGISTRY_JSON=

# ---------------------------------------------------------------- fix engine
FIXENGINE_ENABLED=0
FIXENGINE_CREDITS_INR=400
FIXENGINE_BUDGET_INR=300
# docker (needs Docker here), remote (a sandbox_service.py host), local_unsafe (tests only)
FIXENGINE_SANDBOX_MODE=docker
FIXENGINE_SANDBOX_URL=
FIXENGINE_SANDBOX_SECRET=

# ---------------------------------------------------------------- push guard and monitoring
PUSH_CHECKS_ENABLED=1
PUSH_POLL_SECONDS=180
PUSH_MAX_CHECKS_PER_HOUR=12
# A server-side monitor that has not checked in for this long is "Monitor offline" (monitors check in every 30 s)
MONITOR_OFFLINE_SECONDS=120
# Installed but no check-in at all after this long = "Never checked in" (and one email to the owner)
MONITOR_FIRST_CHECKIN_GRACE_SECONDS=1800
# How often the worker re-checks that connected repositories are still private
VISIBILITY_CHECK_SECONDS=600

# ---------------------------------------------------------------- worker
# 1 = run the worker inside the web service (one free Render service). 0 when a separate worker service runs.
PORTAL_RUN_WORKER=1
WORKER_POLL_SECONDS=5
WORKER_MIN_OCCURRENCES=1
WORKER_MIN_AGE_SECONDS=30

# ---------------------------------------------------------------- payments
# Manual UPI checkout stays disabled until a private destination is configured.
UPI_ID=
UPI_PAYEE_NAME=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
